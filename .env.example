# These are OPTIONAL OVERRIDES. The backend host is code-derived from the build
# mode (src/lib/api.ts, src/auth/handoff.ts): `vite build` (prod) → the deployed
# backend https://api.emberqa.com, `vite` (dev) → the local backend :3000. So you
# do NOT need to set anything here for a normal prod build. Only set these to
# point a build at a different backend host.

# Base URL of the EmberQA backend's authenticated API (no trailing slash).
# Local BACKEND is :3000 (NOT :3001 — that's the EmberQA frontend).
VITE_API_BASE=http://localhost:3000

# Base URL of the UNAUTHENTICATED dialer-auth router (handoff exchange).
# Same host as the backend, mounted outside /api/v1. Defaults to VITE_API_BASE
# host + /dialer-auth/v1 — kept separate in case it ever differs.
VITE_DIALER_AUTH_BASE=http://localhost:3000/dialer-auth/v1
